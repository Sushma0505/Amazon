
pipeline {
    agent any

    parameters {
        booleanParam(
            name: 'FORCE_FAILURE',
            defaultValue: false,
            description: 'Check to test failure email'
        )
    }

    stages {
        stage('Validate') {
            steps {
                echo 'Validation completed'
            }
        }

        stage('Build') {
            steps {
                echo 'Build completed'
            }
        }

        stage('Test') {
            steps {
                script {
                    if (params.FORCE_FAILURE) {
                        error('Intentional test failure')
                    }
                    echo 'Test passed'
                }
            }
        }
    }

    post {
        success {
            emailext(
                to: 'sushmasus2021@gmail.com',
                subject: "SUCCESS: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """Hello Team,

Jenkins build completed successfully.

Job: ${env.JOB_NAME}
Build: ${env.BUILD_NUMBER}
Status: SUCCESS
Build URL: ${env.BUILD_URL}

Regards,
Jenkins
"""
            )
        }

        failure {
            emailext(
                to: 'sushmasus2021@gmail.com',
                subject: "FAILURE: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """Hello Team,

Jenkins build failed.

Job: ${env.JOB_NAME}
Build: ${env.BUILD_NUMBER}
Status: FAILURE
Build URL: ${env.BUILD_URL}

Regards,
Jenkins
"""
            )
        }
    }
}
